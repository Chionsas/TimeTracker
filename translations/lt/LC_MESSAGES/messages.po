msgstr "Jurisdikcijos rinkinys"

#: app/templates/admin/roles/list.html:138
#: app/templates/admin/settings.html:232 app/templates/kanban/columns.html:135
msgid "Custom"
msgstr "Savas"

#: app/templates/admin/settings.html:233
msgid "Belgium (2027)"
msgstr "Belgija (2027)"

#: app/templates/admin/settings.html:234
msgid "EU generic"
msgstr "Bendrasis ES"

#: app/templates/admin/settings.html:238
msgid "Standard daily hours"
msgstr "Standartinės dienos darbo valandos"

#: app/templates/admin/settings.html:242
msgid "Standard weekly hours"
msgstr "Standartinės savaitės darbo valandos"

#: app/templates/admin/settings.html:246
msgid "Retention (years)"
msgstr "Duomenų saugojimo laikotarpis (metais)"

#: app/templates/admin/settings.html:252
msgid "Break required after (hours)"
msgstr "Pertrauka privaloma po (valandų)"

#: app/templates/admin/settings.html:256
msgid "Minimum break (minutes)"
msgstr "Mažiausia pertrauka (minutėmis)"

#: app/templates/admin/settings.html:260
msgid "Minimum daily rest (hours)"
msgstr "Minimalus paros poilsis (valandomis)"

#: app/templates/admin/settings.html:267
msgid "Automatically deduct break on clock-out"
msgstr "Automatiškai išskaičiuoti pertrauką baigiant darbą"

#: app/templates/admin/settings.html:269
msgid ""
"When enabled, a break is automatically deducted on clock-out if the "
"workday exceeds the threshold and no sufficient break has been recorded."
msgstr ""
"Įjungus, baigiant darbą pertrauka išskaičiuojama automatiškai, jei darbo "
"diena viršija ribą ir nebuvo užregistruota pakankama pertrauka."

#: app/templates/admin/settings.html:272
msgid "Deduct break after (hours)"
msgstr "Išskaičiuoti pertrauką po (valandų)"

#: app/templates/admin/settings.html:276
msgid "Break duration (minutes)"
msgstr "Pertraukos trukmė (minutėmis)"

#: app/templates/admin/settings.html:283
msgid "Require workday registration for all employees"
msgstr "Reikalauti, kad visi darbuotojai registruotų darbo dieną"

#: app/templates/admin/settings.html:285
msgid ""
"Belgium preset: 8h/day, 38h/week, 15 min break after 6h, 11h daily rest, "
"10-year retention. Inspector export: Workforce → Belgium attendance "
"report."
msgstr ""
"Belgijos rinkinys: 8 val./d., 38 val./sav., 15 min. pertrauka po 6 val., "
"11 val. paros poilsis, saugojimas 10 metų. Eksportas inspektoriui: "
"Darbuotojai → Belgijos lankomumo ataskaita."

